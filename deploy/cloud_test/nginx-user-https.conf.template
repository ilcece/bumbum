# 用户测试站点，仅此文件的精确路由开放；管理站点IP限制保持不变。
# 与管理模板一起使用；日志格式不记录触碰查询参数、Cookie或正文。
log_format bumbum_user '$time_iso8601 $request_method $uri $status';
limit_req_zone $binary_remote_addr zone=bumbum_user_view:1m rate=5r/s;
server {
    listen 80;
    server_name nfc.bumbum.cc;
    access_log /var/log/nginx/bumbum-user-access.log bumbum_user;
    if ($host != nfc.bumbum.cc) { return 444; }
    location ^~ /.well-known/acme-challenge/ { root /var/www/bumbum-user-test; try_files $uri =404; }
    location / { return 301 https://nfc.bumbum.cc$request_uri; }
}
server {
    listen 443 ssl;
    server_name nfc.bumbum.cc;
    if ($host != nfc.bumbum.cc) { return 444; }
    ssl_certificate /etc/letsencrypt/live/nfc.bumbum.cc/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nfc.bumbum.cc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /var/www/bumbum-user-test;
    access_log /var/log/nginx/bumbum-user-access.log bumbum_user;
    client_max_body_size 8k;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    error_page 413 = @user_payload;
    location = / { return 302 /tap; }
    location = /tap {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /index.html =404;
    }
    location ~ ^/tap/items/[1-9][0-9]*$ {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /index.html =404;
    }
    location /assets/ { try_files $uri =404; }
    location = /api/tap/verify {
        if ($request_method != POST) { return 405; }
        proxy_pass http://127.0.0.1:15000;
        include /etc/nginx/bumbum-cloud-test-proxy.conf;
    }
    location ~ ^/api/tap/items/[1-9][0-9]*/view$ {
        if ($request_method != GET) { return 405; }
        limit_req zone=bumbum_user_view burst=10 nodelay;
        limit_req_status 429;
        error_page 429 = @user_limited;
        proxy_pass http://127.0.0.1:15000;
        include /etc/nginx/bumbum-cloud-test-proxy.conf;
    }
    location @user_limited {
        default_type application/json;
        add_header Retry-After "1" always;
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 429 '{"status":"error","code":"rate_limited","message":"资料查询较频繁，请稍后重试更新。"}';
    }
    location @user_payload {
        default_type application/json;
        return 400 '{"status":"error","code":"invalid_param","message":"提交内容过大"}';
    }
    # 包括/api/admin、旧详情、短信、登记回调及未知静态路径，一律不经此站点开放。
    location / { return 404; }
}

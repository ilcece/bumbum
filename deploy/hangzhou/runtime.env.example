# 杭州每个环境分别保管的秘密模板；复制到该环境secrets/runtime.env后设为600。
# 不在这里填写真实值或提交；Compose使用raw模式，不对密码中的$等字符插值。
# 所有值写成单行，不加引号；不要使用换行或NUL字符。
# 数据库账号、库、端点和TLS由公开Compose固定，不在这里覆盖。
DB_PASSWORD=
STORAGE_ENCRYPTION_KEY=
IP_HASH_KEY=
WEBHOOK_ADMIN_USERNAME=
WEBHOOK_SHARED_SECRET=
# 新环境样品需独立密钥；迁移香港实卡时按另行批准方案保留原有必要密钥，不能重新生成替代。
MASTER_KEY_FASHION=
MASTER_KEY_JEWELRY=
SDM_META_KEY_V1=
SDM_META_KEY_VERSION=v1
TAP_VERIFY_PER_MINUTE=60

# Copy to .env, chmod 600. Compose >= 2.30 supports format: raw.
# Do not quote raw values. Percent-encode URL username/password (including $ as %24).
APP_IMAGE=bumbum:1.0.0
SITE_DOMAIN=nfc.example.com
ACME_EMAIL=ops@example.com
PUBLIC_BASE_URL=https://nfc.example.com
DATABASE_URL=mysql://bumbum_app:REPLACE_WITH_URL_ENCODED_PASSWORD@rds-internal.example.com:3306/bumbum_mvp
# Generate privately: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_64_OR_MORE_RANDOM_CHARACTERS
DB_TLS=true
DB_CA_FILE=/run/db-ca.pem

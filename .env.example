# 仅供本地配置参考，禁止在此填写生产环境秘密。
# 当前尚无应用代码，配置范围与验证规则见 TECH_SPEC.md。
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=bumbum_digital

# 按项目隔离的候选主密钥：16 字节，即 32 位十六进制字符。
# SDM 密钥角色和选钥方案获得批准并通过测试前，保持为空。
MASTER_KEY_FASHION=
MASTER_KEY_JEWELRY=
# 独立的密钥包装密钥：32 字节，即 64 位十六进制字符，用于加密存储秘密。
STORAGE_ENCRYPTION_KEY=
STORAGE_KEY_VERSION=v1
# 用于 IP 和限流标识的独立 HMAC 密钥：32 字节，即 64 位十六进制字符。
IP_HASH_KEY=
# 用于会话绑定 CSRF 凭证的独立 HMAC 密钥：32 字节，即 64 位十六进制字符。
CSRF_HMAC_KEY=
WEBHOOK_SHARED_SECRET=
ADMIN_TOTP_ISSUER="BUMBUM Admin"

# 仅供开发环境使用的来源地址；生产环境采用同源请求。
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# 管理接口携带凭证时，CORS 和 Origin 校验只能使用此单一来源，不能使用上述完整列表。
# 生产环境值：https://admin.bumbum.cc
ADMIN_ORIGIN=http://localhost:5174
# 此处已包含 API 前缀，前端接口路径必须省略 /api。
# 生产环境值：/api
VITE_API_BASE_URL=http://localhost:5000/api

# 仅用于第二阶段：短信挑战的独立 HMAC 密钥，32 字节，即 64 位十六进制字符。
SMS_CODE_HASH_KEY=
# 短信服务提供商及其凭证要求尚待确定。

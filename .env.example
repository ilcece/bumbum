# 这是本机配置模板。先运行 python scripts/setup_local.py，自动生成不上传的 .env。
# 本轮只使用本地测试数据库；芯片和短信密钥继续留空；管理员认证配置另按登录说明准备。本模板只放空值和公开示例。
# 详细格式和安全规则见 TECH_SPEC.md 及 docs/IMPLEMENTATION_DETAILS.md。

# 明确本机开发环境，只有本机HTTP来源可使用非Secure登录Cookie；正式环境必须改为production并使用HTTPS。
APP_ENV=development

# 数据库：连接地址、端口、账号、密码和库名。localhost 表示本机。
DB_HOST=127.0.0.1
DB_PORT=33306
DB_USER=
DB_PASSWORD=
DB_NAME=bumbum_digital
# 仅供 Docker 初始化本地测试库的管理密码，由准备脚本随机生成，不交给后端使用。
DEV_DB_ROOT_PASSWORD=

# 项目根密钥：分别为服装、饰品计算 K0、K2、K3、K4，不直接写进芯片。
# 各为 16 字节，写成 32 位十六进制字符；计算规则核验、真实单卡测试完成前保持为空。
MASTER_KEY_FASHION=
MASTER_KEY_JEWELRY=

# 全局 K1：解开链接中的芯片编号和读取序号；同版本所有项目共享，不按芯片编号计算。
# 独立安全随机生成 16 字节，写成 32 位十六进制字符；不能全零或复用其他密钥。
# 此处只声明需要这项配置，不生成或填写真实秘密。
SDM_META_KEY_V1=
# 初期只支持 v1，版本和芯片配置的对应关系见技术附录第 2 节。
# 换版本要先定义旧卡怎样继续使用、怎样更新和恢复，不能只改这里。
SDM_META_KEY_VERSION=v1

# 存储密钥：加密用于保护数据库秘密的临时钥匙；与芯片密钥分开。
# 独立 32 字节，写成 64 位十六进制字符；下一项是它的版本。
STORAGE_ENCRYPTION_KEY=
STORAGE_KEY_VERSION=v1

# 给日志中的访问来源、未知账号及第二阶段请求计数标识计算指纹，不存原始 IP 等标识。
# 使用带秘密的指纹算法 HMAC；独立 32 字节，写成 64 位十六进制字符。
IP_HASH_KEY=
# 登录防冒用口令由组件随机生成并随会话保存，不需要单独配置密钥。
# 扫描回调尚未实现，以下两项为预留配置；当前登录及手动登记不需要填写。
# NFC.cool 的 Basic 认证用户名：已有、启用且完成验证器设置的管理员账号名。
WEBHOOK_ADMIN_USERNAME=
# Basic 认证密码：独立随机32字节，写成64位十六进制；不能复用管理员登录密码。
# 只通过HTTPS发送，不放链接或日志；真实手机认证握手仍待验证。
WEBHOOK_SHARED_SECRET=
# 验证器 App 中显示的服务名称，是公开文字。
ADMIN_TOTP_ISSUER="BUMBUM Admin"

# 本地开发时，浏览器允许哪些网页调用接口（CORS）；正式环境由各网站访问自己的接口。
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# 管理接口只允许下面这个管理网页来源，不能使用上面的全部列表。
# 正式环境值：https://admin.bumbum.cc
ADMIN_ORIGIN=http://localhost:5174
# 网页使用 /api；开发时由 Vite 转给本机后端，正式环境由 Nginx 转交。
# 地址已包含 /api，调用时只补后面的路径。
# VITE_ 配置会进入网页，不能放秘密；正式环境值：/api。
VITE_API_BASE_URL=/api

# 第二阶段才用：保存短信码校验指纹，验证它与本次触碰凭证、手机号是否对应。
# 使用独立 HMAC 密钥，32 字节，写成 64 位十六进制字符。
SMS_CODE_HASH_KEY=
# 短信服务商尚未选定，对方要求的配置以后再补。

# Local configuration template only; never enter production secrets here.
# No application exists yet. See TECH_SPEC.md for scope and validation rules.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=bumbum_digital

# Proposed per-project root keys: 16 bytes / 32 hex characters.
# Keep empty until SDM key roles and selection are approved and tested.
MASTER_KEY_FASHION=
MASTER_KEY_JEWELRY=
# Independent wrapping key: 32 bytes / 64 hex characters; required for encrypted secrets.
STORAGE_ENCRYPTION_KEY=
STORAGE_KEY_VERSION=v1
# Independent 32-byte / 64-hex HMAC key for IP/rate-limit identifiers.
IP_HASH_KEY=
# Independent 32-byte / 64-hex HMAC key for session-bound CSRF tokens.
CSRF_HMAC_KEY=
WEBHOOK_SHARED_SECRET=
ADMIN_TOTP_ISSUER="BUMBUM Admin"

# Development-only origins. Production uses same-origin requests.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Admin credentialed CORS/Origin must use this single origin, not the whole list.
# Production value: https://admin.bumbum.cc
ADMIN_ORIGIN=http://localhost:5174
# API prefix included here; frontend endpoint strings MUST omit /api.
# Production value: /api
VITE_API_BASE_URL=http://localhost:5000/api

# Phase 2 only; independent 32-byte / 64-hex HMAC key for SMS challenges.
SMS_CODE_HASH_KEY=
# SMS provider and its credential requirements are pending selection.
